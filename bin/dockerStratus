#!/bin/bash

#--------------------------------------------------------------------
# Compile for Chaos Audio Stratus pedal by using a docker command.
# $DOCKERIMAGE is the docker image to be used

CDIR=`pwd`
DOCKERIMAGE='bassmanitram/chaos-stratus-effect-build:latest'

# Produce run commands producing output into the PWD
echo docker run --rm -v "$CDIR:/tmp" $DOCKERIMAGE "$@"
docker run --rm -v "$CDIR:/tmp" $DOCKERIMAGE $@
